# Optional for local dev: if unset, app/db.py falls back to a local SQLite
# file (./dev.db) so you can run the prototype without installing Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/thalat_tha_na_map
ENCRYPTION_KEY=replace-with-generated-fernet-key
# Shared secret for the /api/admin/* endpoints (decrypted visitor scan log).
# Send as the X-Admin-Key header. Generate a long random value, don't reuse it.
ADMIN_API_KEY=replace-with-a-long-random-value
